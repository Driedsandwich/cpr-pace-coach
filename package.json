{
  "name": "cpr-pace-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only landmark rhythm coach for manikin or cushion practice",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./video": {
      "types": "./dist/src/video.d.ts",
      "import": "./dist/src/video.js"
    },
    "./schema": "./schema/session.schema.json"
  },
  "scripts": {
    "build": "npm run typecheck && tsc -p tsconfig.build.json && node scripts/web-assets.mjs && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "schema": "tsx scripts/schema.ts",
    "start": "tsx scripts/demo.ts",
    "mcp": "tsx mcp/server.ts",
    "dev": "node scripts/web-assets.mjs && vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@modelcontextprotocol/server": "2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
