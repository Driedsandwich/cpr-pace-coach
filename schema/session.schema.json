{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "purpose": {
      "type": "string",
      "const": "practice-only"
    },
    "plannedDurationMs": {
      "type": "number",
      "const": 120000
    },
    "durationMs": {
      "type": "number",
      "minimum": 0,
      "maximum": 120000
    },
    "completed": {
      "type": "boolean"
    },
    "compressionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rate": {
      "type": "object",
      "properties": {
        "targetMinCpm": {
          "type": "number",
          "const": 100
        },
        "targetMaxCpm": {
          "type": "number",
          "const": 120
        },
        "evaluableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inTargetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inTargetFraction": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "averageCpm": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "rhythmCv": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "targetMinCpm",
        "targetMaxCpm",
        "evaluableCount",
        "inTargetCount",
        "inTargetFraction",
        "averageCpm",
        "rhythmCv"
      ],
      "additionalProperties": false
    },
    "pauses": {
      "type": "object",
      "properties": {
        "thresholdMs": {
          "type": "number",
          "const": 2000
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalMs": {
          "type": "number",
          "minimum": 0
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "number",
                "minimum": 0
              },
              "endMs": {
                "type": "number",
                "minimum": 0
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "startMs",
              "endMs",
              "durationMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "thresholdMs",
        "count",
        "totalMs",
        "intervals"
      ],
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "properties": {
        "observedMs": {
          "type": "number",
          "minimum": 0
        },
        "unknownMs": {
          "type": "number",
          "minimum": 0
        },
        "activeMs": {
          "type": "number",
          "minimum": 0
        },
        "chestCompressionFraction": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observedCompressionFraction": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "observedMs",
        "unknownMs",
        "activeMs",
        "chestCompressionFraction",
        "observedCompressionFraction"
      ],
      "additionalProperties": false
    },
    "arms": {
      "type": "object",
      "properties": {
        "bentThresholdDeg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 180
        },
        "observedMs": {
          "type": "number",
          "minimum": 0
        },
        "bothStraightMs": {
          "type": "number",
          "minimum": 0
        },
        "bothStraightFraction": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "meanLeftDeg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "meanRightDeg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bentThresholdDeg",
        "observedMs",
        "bothStraightMs",
        "bothStraightFraction",
        "meanLeftDeg",
        "meanRightDeg"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "purpose",
    "plannedDurationMs",
    "durationMs",
    "completed",
    "compressionCount",
    "rate",
    "pauses",
    "activity",
    "arms"
  ],
  "additionalProperties": false,
  "title": "CPR practice session result",
  "description": "Practice-only measurements. Fractions range 0–1. Times in ms; pause endpoints relative to session start. See README for definitions. Cross-field arithmetic is validated by parseSessionResult."
}
